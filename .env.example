# Backend runtime configuration
DATABASE_PATH=backend/data/call_agent.db
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional background Web Push. Keep VAPID_PRIVATE_KEY secret; use one stable key pair per deployment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# Store these only in the ignored local .env file or your deployment secret store.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Voice number or carrier DID routed to this app through a Twilio BYOC trunk.
TWILIO_PHONE_NUMBER=
# Twilio requires a publicly reachable HTTPS origin; localhost is for local development only.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Inbound calling uses a Twilio Voice number or an India DID/SIP carrier connected through Twilio BYOC.
# Configure the number/BYOC trunk and its voice webhook in Twilio Console; no phone number is stored here.
FRONTEND_ORIGIN=http://127.0.0.1:5173
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# Optional Render deployment values
# PUBLIC_BASE_URL=https://your-backend.onrender.com
# FRONTEND_ORIGIN=https://your-frontend.onrender.com

# Frontend runtime configuration
# Copy to frontend/.env.local or set these in your deployment environment
VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_BASE_URL=https://your-backend.onrender.com
AUTH_REQUIRED=false
APP_USERNAME=
APP_PASSWORD=
APP_TOKEN_SECRET=
